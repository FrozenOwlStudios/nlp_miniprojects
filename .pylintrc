[MAIN]
py-version=3.13
jobs=0
persistent=yes
fail-under=9.0

# Enable all checks, then selectively disable unwanted ones.
enable=all

disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    invalid-name,
    locally-disabled,
    suppressed-message,
    file-ignored,
    use-symbolic-message-instead,
    deprecated-pragma

[FORMAT]
max-line-length=100
max-module-lines=1000
indent-string='    '
expected-line-ending-format=LF

[DESIGN]
max-args=6
max-positional-arguments=6
max-locals=15
max-returns=4
max-branches=10
max-statements=40
max-parents=5
max-attributes=8
max-public-methods=15
min-public-methods=0
max-bool-expr=4

[REFACTORING]
max-nested-blocks=4

[BASIC]
good-names=
    i,
    j,
    k,
    x,
    y,
    z,
    _,
    id,
    db,
    fp

argument-naming-style=snake_case
attr-naming-style=snake_case
class-naming-style=PascalCase
class-attribute-naming-style=any
const-naming-style=UPPER_CASE
function-naming-style=snake_case
method-naming-style=snake_case
module-naming-style=snake_case
variable-naming-style=snake_case

[VARIABLES]
init-import=no
dummy-variables-rgx=^(_+|unused_.*)$
additional-builtins=

[TYPECHECK]
ignore-none=no
ignore-on-opaque-inference=yes
ignore-mixin-members=yes

[IMPORTS]
allow-wildcard-with-all=no
analyse-fallback-blocks=yes
preferred-modules=

[SIMILARITIES]
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
ignore-signatures=no

[CLASSES]
check-protected-access-in-special-methods=yes
defining-attr-methods=
    __init__,
    __new__,
    setUp,
    __post_init__

[LOGGING]
logging-format-style=old


[EXCEPTIONS]
# We are ok with caching a Exception as our interface should be able to hide 
# any error. To get default behavior add builtins.Exception
overgeneral-exceptions=
    builtins.BaseException,
